# ShopScale local environment template.
# Copy to .env and fill in secrets. Never commit .env.
# All values validated at boot by @shopscale/config (see packages/config/src/index.ts).

NODE_ENV=development
PORT=3000

# PostgreSQL (core profile, see infra/compose.yml in T004).
DATABASE_URL=postgres://shopscale:shopscale@localhost:5432/shopscale

# Redis cache (evictable) and jobs (durable, separate instance).
REDIS_CACHE_URL=redis://localhost:6379
REDIS_JOBS_URL=redis://localhost:6380

# Auth: 32+ char secrets. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-32-plus-char-access-secret-0000
JWT_REFRESH_SECRET=change-me-to-32-plus-char-refresh-secret-00
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Browser cookies (shared demo origin; custom domains are production work).
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Deterministic mock payment provider (demo only, no real money).
MOCK_PAYMENTS_SECRET=change-me-to-32-plus-char-mock-pay-secret-0

# Object storage profile (optional until media tasks).
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=shopscale
MINIO_REGION=us-east-1
