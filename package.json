{
  "name": "shopscale",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ShopScale multi-vendor e-commerce marketplace — portfolio demo",
  "scripts": {
    "install:all": "pnpm install --recursive",
    "build": "pnpm -r --filter=./apps/** --filter=./packages/** run build",
    "build:apps": "pnpm -r --filter=./apps/** run build",
    "build:packages": "pnpm -r --filter=./packages/** run build",
    "typecheck": "pnpm -r --filter=./apps/** --filter=./packages/** run typecheck",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js apps packages scripts tests playwright.config.ts eslint.config.js",
    "test": "pnpm -r --filter=./apps/** --filter=./packages/** run test",
    "test:unit": "pnpm -r --filter=./apps/** --filter=./packages/** run test:unit",
    "test:integration": "pnpm -r --filter=./apps/** --filter=./packages/** run test:integration",
    "db:generate": "pnpm --filter=@shopscale/backend run db:generate",
    "db:migrate": "pnpm --filter=@shopscale/backend run db:migrate",
    "db:seed": "pnpm --filter=@shopscale/backend run db:seed",
    "db:backup": "pnpm --filter=@shopscale/backend run db:backup",
    "db:restore": "pnpm --filter=@shopscale/backend run db:restore",
    "seed": "pnpm --filter=@shopscale/backend run db:seed --",
    "seed:verify": "pnpm --filter=@shopscale/backend run db:seed -- --verify",
    "search:reindex": "tsx scripts/reindex.ts",
    "settlement": "tsx scripts/settlement.ts",
    "loadtest:flash-sale": "k6 run loadtests/flash-sale.js",
    "loadtest:browse": "k6 run loadtests/browse-mix.js",
    "loadtest:search": "k6 run loadtests/search-stress.js",
    "loadtest:checkout": "k6 run loadtests/checkout-load.js",
    "loadtest:soak": "k6 run loadtests/soak-test.js",
    "test:chaos": "vitest run tests/chaos/worker-crash.spec.ts",
    "test:security": "vitest run tests/security/security-regression.spec.ts",
    "benchmark:queries": "pnpm --filter=@shopscale/backend exec tsx ../../scripts/benchmark-queries.ts",
    "benchmark:search": "pnpm --filter=@shopscale/backend run benchmark:search",
    "benchmark:partitioning": "pnpm --filter=@shopscale/backend run benchmark:partitioning",
    "benchmark:soak": "pnpm --filter=@shopscale/backend run benchmark:soak",
    "benchmark:all": "pnpm benchmark:queries && pnpm benchmark:search && pnpm benchmark:partitioning && pnpm benchmark:soak",
    "lighthouse": "node apps/web/node_modules/@lhci/cli/src/cli.js autorun --config=lighthouserc.json",
    "lighthouserc": "node apps/web/node_modules/@lhci/cli/src/cli.js autorun --config=lighthouserc.json",
    "infra:up": "node scripts/dev-infra.mjs up",
    "infra:jobs": "node scripts/dev-infra.mjs jobs",
    "infra:ps": "node scripts/dev-infra.mjs ps",
    "infra:down": "node scripts/dev-infra.mjs down",
    "infra:reset": "node scripts/dev-infra.mjs reset --confirm",
    "openapi": "node scripts/openapi.mjs",
    "dev:api": "pnpm --filter=@shopscale/api run start:dev",
    "dev:worker": "pnpm --filter=@shopscale/worker run start:dev",
    "dev:web": "pnpm --filter=@shopscale/web run dev",
    "dev:all": "concurrently \"pnpm:dev:api\" \"pnpm:dev:worker\" \"pnpm:dev:web\"",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^8.57.0",
    "@types/node": "^20.12.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.0.11",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.2",
    "vitest": "1.6.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}