{
  "name": "@shopscale/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@shopscale/backend": "workspace:*",
    "@shopscale/config": "workspace:*",
    "@shopscale/contracts": "workspace:*",
    "bullmq": "^5.10.0",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.5",
    "vitest": "^1.4.0"
  }
}